<resources>
    <!--
      How much of the designed type scale this language uses, as a percentage.

      An integer rather than a float: a dimension resource has to carry a unit,
      and reading a bare number as one throws at the moment the theme is first
      composed, which is the moment the app opens.
    -->
    <integer name="type_scale_percent">100</integer>

    <!--
      Leading, as a percentage of the designed line height.
    -->
    <integer name="type_leading_percent">100</integer>

    <!--
      Tracking. Latin display sizes keep the tightening they were drawn with.
    -->
    <integer name="type_tracking_percent">100</integer>

    <!--
      The design was drawn in Inter.
    -->
    <bool name="type_persian_face">false</bool>
</resources>
